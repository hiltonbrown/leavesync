{
  "name": "team-calendar",
  "version": "6.0.2",
  "scripts": {
    "build": "turbo build --filter=!email",
    "dev": "bunx turbo dev --ui=stream --filter=app --filter=api --filter=web --filter=email",
    "check": "ultracite check apps packages scripts tooling tsup.config.ts",
    "fix": "ultracite fix apps packages scripts tooling tsup.config.ts",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && bunx prisma format && bunx prisma generate && bunx prisma migrate dev",
    "migrate:deploy": "cd packages/database && bunx prisma generate && bunx prisma migrate deploy",
    "db:push": "cd packages/database && bunx prisma format && bunx prisma generate && bunx prisma db push",
    "clean": "git clean -xdf node_modules",
    "preflight": "bun run packages/next-config/bin/preflight.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@repo/typescript-config": "*",
    "@turbo/gen": "^2.10.12",
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22 || >=24.0.0"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "nypm": "^0.6.9"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "import-in-the-middle": "3.3.3",
    "next": "16.3.3",
    "parse5": "^7.2.1",
    "protobufjs": "7.6.5",
    "require-in-the-middle": "8.0.1",
    "vite": "8.0.16"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
  }
}
